# Copy to .env and fill in.  .env is gitignored - never commit real values.
# The previous project committed its .env; those keys must be treated as
# compromised and rotated before reuse.

# ---- local LLM stage (pipeline stage 5) ----
OLLAMA_HOST=http://127.0.0.1:11434
OLLAMA_MODEL=llama3.2:3b
OLLAMA_TIMEOUT_S=120

# ---- storage ----
# dev default is SQLite; switch to postgresql+psycopg2://... for deployment
DATABASE_URL=sqlite:///./data/processed/osint_shield.db

# ---- ingestion (phase 7 - leave blank until then) ----
NEWS_API_KEY=
YOUTUBE_API_KEY=
TELEGRAM_API_ID=
TELEGRAM_API_HASH=
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
REDDIT_USER_AGENT=osint-shield/0.1

# ---- huggingface ----
# only needed for gated models; mmBERT and XLM-R are public
HF_TOKEN=
HF_HOME=./.cache/huggingface

# ---- runtime ----
LOG_LEVEL=INFO
RANDOM_SEED=42
